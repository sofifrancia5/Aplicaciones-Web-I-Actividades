<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 80" width="320" height="80">
  <!-- Fondo transparente o redondeado opcional -->
  <rect width="100%" height="100%" fill="none"/>
  
  <!-- Icono: Montañas y Hoja Sustentable -->
  <g transform="translate(10, 10)">
    <!-- Montaña trasera -->
    <polygon points="25,50 45,20 65,50" fill="#a3c2b2" />
    <!-- Montaña principal -->
    <polygon points="10,55 35,12 60,55" fill="#2d4a3e" />
    <!-- Detalle de la hoja sustentable -->
    <path d="M35,22 C45,10 55,25 45,38 C38,47 35,22 35,22 Z" fill="#78ab8f" opacity="0.9"/>
  </g>

  <!-- Texto del Isologotipo -->
  <text x="80" y="38" font-family="'Segoe UI', Arial, sans-serif" font-size="20" font-weight="bold" fill="#ffffff" letter-spacing="0.5">RETIRO</text>
  <text x="80" y="56" font-family="'Segoe UI', Arial, sans-serif" font-size="14" font-weight="300" fill="#a3c2b2" letter-spacing="1.5">SUSTENTABLE</text>
</svg>
